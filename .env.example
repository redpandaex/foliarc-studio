# ==============================================================================
# FoliarcStudio - Local Development Environment Configuration
# Copy to .env and fill in secrets before running services:
#   cp .env.example .env
# ==============================================================================

# --- Core Infrastructure (Docker Compose profile: core) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=foliarc
POSTGRES_USER=foliarc
POSTGRES_PASSWORD=foliarc_dev_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RAG Infrastructure (Docker Compose profile: rag) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCS=foliarc-docs

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=foliarc
RABBITMQ_PASSWORD=foliarc_dev_password

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# --- Service Ports & URLs ---
WEB_PORT=3000
BIZ_JAVA_PORT=8080
AGENT_PY_PORT=8000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
AGENT_PY_BASE_URL=http://localhost:8000

# --- Security & Internal Auth ---
# Change these in any non-local environment (HS256 requires >= 32 bytes)
JWT_SECRET=foliarc-dev-jwt-secret-change-me-at-least-32-chars
INTERNAL_SERVICE_TOKEN=foliarc-internal-dev-token-change-me

# --- Unified OpenAI-Compatible LLM Gateway (Logical Model Aliases) ---
# Works with DeepSeek official API, OpenRouter, SiliconFlow, LiteLLM, or company internal AI gateway
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here

# Logical aliases mapped to concrete upstream models
LLM_MODEL_WRITER_MAIN=deepseek-chat
LLM_MODEL_CRITIC_REASONER=deepseek-reasoner
LLM_MODEL_FAST_ROUTER=deepseek-chat
LLM_MODEL_EMBED=BAAI/bge-m3
LLM_MODEL_RERANK=BAAI/bge-reranker-v2-m3

# --- Optional External Embedding & Rerank API (SiliconFlow / DashScope / OpenAI) ---
# Leave API keys blank to automatically use built-in deterministic local fallback (1024-dim)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
RERANK_BASE_URL=
RERANK_API_KEY=
