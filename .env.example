# ==============================================================================
# FoliarcStudio - Local Development Environment Configuration
# Copy to .env and fill in secrets before running services:
#   cp .env.example .env
# ==============================================================================

# --- Core Infrastructure (Docker Compose profile: core) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=foliarc
POSTGRES_USER=foliarc
POSTGRES_PASSWORD=foliarc_dev_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RAG Infrastructure (Docker Compose profile: rag) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCS=foliarc-docs

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=foliarc
RABBITMQ_PASSWORD=foliarc_dev_password

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# --- Service Ports & URLs ---
GATEWAY_PORT=8088
WEB_PORT=3000
ADMIN_WEB_PORT=3001
BIZ_JAVA_PORT=8080
ADMIN_JAVA_PORT=8081
AGENT_PY_PORT=8000

# Direct mode (default): http://localhost:8080. Same-origin Nginx gateway mode (:8088): set empty NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8081
ADMIN_CORS_ALLOWED_ORIGINS=http://localhost:3001
AGENT_PY_BASE_URL=http://localhost:8000

# --- Gateway Observability & Global Rate Limit ---
HTTP_ACCESS_LOG_ENABLED=true
GATEWAY_GLOBAL_RL_ENABLED=true
GATEWAY_GLOBAL_BURST_10S=60
GATEWAY_GLOBAL_RPM_LIMIT=240

# --- Security & Internal Auth ---
# Change these in any non-local environment (HS256 requires >= 32 bytes)
JWT_SECRET=foliarc-dev-jwt-secret-change-me-at-least-32-chars
ADMIN_JWT_SECRET=foliarc-dev-admin-jwt-secret-change-me-at-least-32-chars
# Optional: auto-promote this registered email to ADMIN when admin-java boots (idempotent)
ADMIN_BOOTSTRAP_EMAIL=
INTERNAL_SERVICE_TOKEN=foliarc-internal-dev-token-change-me

# --- Unified OpenAI-Compatible LLM Gateway (Logical Model Aliases) ---
# Works with local New API (http://new-api:3000/v1), Gemini OpenAI endpoint, DeepSeek, or LiteLLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here

# Use physical model names directly, or configure foliarc-writer, foliarc-critic
# and foliarc-fast as model names after setting up those mappings in your gateway.
LLM_MODEL_WRITER_MAIN=deepseek-chat
LLM_MODEL_CRITIC_REASONER=deepseek-reasoner
LLM_MODEL_FAST_ROUTER=deepseek-chat
# Optional thinking effort for Gemini 3/4 or OpenAI reasoning models: minimal | low | medium | high | xhigh
LLM_REASONING_EFFORT=

# Thinking: auto | on | off. Auto uses model detection, the critic role, or a slot effort.
# For opaque gateway names, set on/off to match the model behind each slot.
LLM_SLOT_WRITER_THINKING=auto
LLM_SLOT_CRITIC_THINKING=auto
LLM_SLOT_FAST_THINKING=auto
# Blank uses global effort. Fast sends low for inherited high/xhigh on thinking
# models and otherwise omits inherited effort. Set FAST_EFFORT to override.
LLM_SLOT_WRITER_EFFORT=
LLM_SLOT_CRITIC_EFFORT=
LLM_SLOT_FAST_EFFORT=
# auto | true | false. Set true for a logical critic backed by a JSON-capable
# reasoning model, or false when its upstream cannot accept JSON mode.
LLM_SLOT_CRITIC_JSON_MODE=auto
# Expanded thinking output budget (4096–65536). Auto-detected non-Gemini
# reasoning models cap at 16384. Non-thinking slots keep the requested budget.
LLM_SLOT_MAX_OUTPUT_CEILING=32768

LLM_MODEL_EMBED=BAAI/bge-m3
LLM_MODEL_RERANK=BAAI/bge-reranker-v2-m3

# --- Self-Hosted AI Gateway (New API, Docker Compose profile: gateway / app / all) ---
# Bound to 127.0.0.1 by default for security; set NEW_API_BIND_HOST=0.0.0.0 only on trusted LAN
NEW_API_BIND_HOST=127.0.0.1
NEW_API_PORT=3002
NEW_API_SESSION_SECRET=change-me-use-openssl-rand-hex-32
NEW_API_CRYPTO_SECRET=change-me-use-openssl-rand-hex-32
# Optional outbound proxy for New API to reach Google Gemini API
NEW_API_HTTP_PROXY=
NEW_API_HTTPS_PROXY=

# --- Optional External Embedding & Rerank API (SiliconFlow / DashScope / OpenAI) ---
# Leave API keys blank to automatically use built-in deterministic local fallback (1024-dim)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
RERANK_BASE_URL=
RERANK_API_KEY=
